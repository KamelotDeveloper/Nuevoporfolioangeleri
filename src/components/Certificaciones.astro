---
import { translations, type Lang } from '../i18n/translations';

interface Props {
  lang?: Lang;
}

const { lang = 'es' } = Astro.props;
const t = translations[lang];

const allCertifications = lang === 'es' 
  ? [
      { title: 'IA y automatización de flujos', subtitle: 'UNC - 20 hs', href: '/automatizacion-n8n.pdf', date: 'Enero 2026', color: 'blue' },
      { title: 'Python - Certificación 1', subtitle: 'UNC - 20 hs', href: '/certificado-python-1.pdf', date: 'Enero 2026', color: 'green' },
      { title: 'Python - Certificación 2', subtitle: 'UNC - 15 hs', href: '/certificado-python-2.pdf', date: 'Enero 2026', color: 'green' },
      { title: 'Community Manager', subtitle: 'UNC - 20 hs', href: '/Certificado Community.png', date: 'Septiembre 2022', color: 'purple' },
      { title: 'Programación HTML & CSS', subtitle: 'UNC - 20 hs', href: '/Certificado.jpg', date: 'Enero 2024', color: 'orange' },
      { title: 'UX Design', subtitle: 'UNC - 20 hs', href: '/UX desing certificado.pdf', date: 'Febrero 2025', color: 'pink' },
    ]
  : [
      { title: 'AI & Workflow Automation', subtitle: 'UNC - 20 hs', href: '/automatizacion-n8n.pdf', date: 'January 2026', color: 'blue' },
      { title: 'Python - Certification 1', subtitle: 'UNC - 20 hs', href: '/certificado-python-1.pdf', date: 'January 2026', color: 'green' },
      { title: 'Python - Certification 2', subtitle: 'UNC - 15 hs', href: '/certificado-python-2.pdf', date: 'January 2026', color: 'green' },
      { title: 'Community Manager', subtitle: 'UNC - 20 hs', href: '/Certificado Community.png', date: 'September 2022', color: 'purple' },
      { title: 'HTML & CSS Programming', subtitle: 'UNC - 20 hs', href: '/Certificado.jpg', date: 'January 2024', color: 'orange' },
      { title: 'UX Design', subtitle: 'UNC - 20 hs', href: '/UX desing certificado.pdf', date: 'February 2025', color: 'pink' },
    ];

const INITIAL_COUNT = 3;
const hasMore = allCertifications.length > INITIAL_COUNT;
---

<section id="certificaciones" class="py-16 sm:py-24">
  <div class="flex items-end justify-between gap-6 flex-wrap mb-12">
    <div>
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-300 text-sm font-medium mb-4">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
        </svg>
        {t.certifications.label}
      </div>
      <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-white">{t.certifications.title}</h2>
      <p class="mt-3 text-lg text-gray-600 dark:text-gray-400">{t.certifications.subtitle}</p>
    </div>
    <a href="#contacto" class="focus-ring inline-flex items-center gap-2 text-base font-semibold text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 transition-colors">
      {t.certifications.cta}
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
      </svg>
    </a>
  </div>

  <!-- Certifications container with gradient -->
  <div class="relative">
    <!-- Gradient fade overlay -->
    <div id="certs-fade" class={`absolute bottom-0 left-0 right-0 h-32 pointer-events-none z-10 bg-gradient-to-t from-white dark:from-gray-900 to-transparent transition-opacity duration-300 ${hasMore ? 'opacity-100' : 'opacity-0'}`}></div>

    <div id="certs-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {allCertifications.map((c, index) => (
        <article class={`cert-hidden relative group rounded-2xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 p-6 shadow-md hover:shadow-2xl dark:shadow-gray-900/30 transition-all duration-300 hover:-translate-y-1 ${index >= INITIAL_COUNT ? '' : ''}`}>
          <div class={`absolute top-0 left-0 w-full h-1 rounded-t-2xl bg-${c.color}-500`}></div>
          <h3 class="text-lg font-bold text-gray-900 dark:text-white pr-8">
            <a href={c.href} target="_blank" rel="noopener noreferrer" class="focus-ring hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
              {c.title}
            </a>
          </h3>
          <p class="mt-3 text-sm text-gray-600 dark:text-gray-400">{c.subtitle}</p>
          <p class="mt-2 text-xs text-gray-400 dark:text-gray-500">{c.date}</p>
          
          <div class="mt-5 flex items-center justify-between">
            <a href={c.href} target="_blank" rel="noopener noreferrer" class="focus-ring text-sm font-medium text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 flex items-center gap-1">
              {t.certifications.viewCertificate}
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </div>
        </article>
      ))}
    </div>

    <!-- Load More Button -->
    {hasMore && (
      <div id="load-more-certs-container" class="relative z-20 flex justify-center mt-8">
        <button
          id="load-more-certs-btn"
          class="focus-ring inline-flex items-center gap-2 px-8 py-4 rounded-xl bg-white dark:bg-gray-800 border-2 border-green-500 text-green-600 dark:text-green-400 font-bold text-lg shadow-lg hover:shadow-xl hover:bg-green-50 dark:hover:bg-gray-700 hover:border-green-600 transition-all duration-300 hover:scale-105"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
          <span id="load-more-certs-text">{lang === 'es' ? 'Ver todas las certificaciones' : 'View all certifications'}</span>
        </button>
      </div>
    )}
  </div>
</section>

<style>
  /* Mobile: show limited with fade */
  @media (max-width: 767px) {
    .cert-hidden:nth-child(n+4) {
      display: none;
    }
    .cert-hidden.expanded {
      display: block;
      animation: fadeSlideIn 0.4s ease-out forwards;
    }
    #certs-fade {
      display: block;
    }
    #load-more-certs-container {
      display: flex;
    }
  }
  
  /* Tablet and up: show all, hide button */
  @media (min-width: 768px) {
    #certs-fade {
      display: none !important;
    }
    #load-more-certs-container {
      display: none !important;
    }
    .cert-hidden:nth-child(n+4) {
      display: block !important;
    }
  }
  
  @keyframes fadeSlideIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<script>
  const loadMoreBtn = document.getElementById('load-more-certs-btn');
  const loadMoreText = document.getElementById('load-more-certs-text');
  const loadMoreContainer = document.getElementById('load-more-certs-container');
  const certsFade = document.getElementById('certs-fade');
  const hiddenCerts = document.querySelectorAll('.cert-hidden');
  const isSpanish = window.location.pathname.startsWith('/es');

  let isExpanded = false;

  loadMoreBtn?.addEventListener('click', () => {
    isExpanded = !isExpanded;
    
    if (isExpanded) {
      // Show all certs with staggered animation
      hiddenCerts.forEach((el, index) => {
        el.classList.add('expanded');
        (el as HTMLElement).style.animationDelay = `${index * 100}ms`;
      });
      
      // Hide fade and button
      certsFade?.classList.add('opacity-0');
      if (loadMoreContainer) loadMoreContainer.style.display = 'none';
    }
  });
</script>