---
import { translations, type Lang } from '../i18n/translations';

interface Props {
  lang?: Lang;
}

const { lang = 'es' } = Astro.props;
const t = translations[lang];
const baseUrl = import.meta.env.BASE_URL;

const colorMap: Record<string, string> = {
  blue: 'bg-blue-500',
  green: 'bg-green-500',
  purple: 'bg-purple-500',
  orange: 'bg-orange-500',
  pink: 'bg-pink-500',
  teal: 'bg-teal-500',
  red: 'bg-red-500',
  indigo: 'bg-indigo-500',
};

const allCertifications = lang === 'es' 
  ? [
      // Desarrollo
      { title: 'Programación HTML & CSS', subtitle: 'UNC - 20 hs', href: baseUrl + '/Certificado.jpg', date: 'Enero 2024', color: colorMap.orange },
      { title: 'Desarrollo con Agentes IA', subtitle: 'The Big School', href: baseUrl + '/desarrollo con ia sdd.pdf', date: '2026', color: colorMap.teal },
      { title: 'Ciberseguridad - Hacking Ético', subtitle: 'The Big School', href: baseUrl + '/Certificado-ciberseguridad hacking etico.pdf', date: '2026', color: colorMap.red },
      // Diseño
      { title: 'UX Design', subtitle: 'UNC - 20 hs', href: baseUrl + '/UX desing certificado.pdf', date: 'Febrero 2025', color: colorMap.pink },
      // Lenguajes y otros
      { title: 'Python - Certificación 2', subtitle: 'UNC - 15 hs', href: baseUrl + '/certificado-python-2.pdf', date: 'Enero 2026', color: colorMap.green },
      { title: 'Python - Certificación 1', subtitle: 'UNC - 20 hs', href: baseUrl + '/certificado-python-1.pdf', date: 'Enero 2026', color: colorMap.green },
      { title: 'Analista de Datos', subtitle: 'UNC', href: baseUrl + '/Certificado analista de datos.pdf', date: '2026', color: colorMap.indigo },
      { title: 'Workflow Automation', subtitle: 'UNC - 20 hs', href: baseUrl + '/automatizacion-n8n.pdf', date: 'Enero 2026', color: colorMap.blue },
      { title: 'Community Manager', subtitle: 'UNC - 20 hs', href: baseUrl + '/Certificado Community.png', date: 'Septiembre 2022', color: colorMap.purple },
    ]
  : [
      // Development
      { title: 'HTML & CSS Programming', subtitle: 'UNC - 20 hs', href: baseUrl + '/Certificado.jpg', date: 'January 2024', color: colorMap.orange },
      { title: 'Development with AI Agents', subtitle: 'The Big School', href: baseUrl + '/desarrollo con ia sdd.pdf', date: '2026', color: colorMap.teal },
      { title: 'Cybersecurity - Ethical Hacking', subtitle: 'The Big School', href: baseUrl + '/Certificado-ciberseguridad hacking etico.pdf', date: '2026', color: colorMap.red },
      // Design
      { title: 'UX Design', subtitle: 'UNC - 20 hs', href: baseUrl + '/UX desing certificado.pdf', date: 'February 2025', color: colorMap.pink },
      // Languages & others
      { title: 'Python - Certification 2', subtitle: 'UNC - 15 hs', href: baseUrl + '/certificado-python-2.pdf', date: 'January 2026', color: colorMap.green },
      { title: 'Python - Certification 1', subtitle: 'UNC - 20 hs', href: baseUrl + '/certificado-python-1.pdf', date: 'January 2026', color: colorMap.green },
      { title: 'Data Analyst', subtitle: 'UNC', href: baseUrl + '/Certificado analista de datos.pdf', date: '2026', color: colorMap.indigo },
      { title: 'Workflow Automation', subtitle: 'UNC - 20 hs', href: baseUrl + '/automatizacion-n8n.pdf', date: 'January 2026', color: colorMap.blue },
      { title: 'Community Manager', subtitle: 'UNC - 20 hs', href: baseUrl + '/Certificado Community.png', date: 'September 2022', color: colorMap.purple },
    ];

const INITIAL_COUNT = 3;
const hasMore = allCertifications.length > INITIAL_COUNT;
---

<section id="certificaciones" class="py-16 sm:py-24">
  <div class="flex items-end justify-between gap-6 flex-wrap mb-12">
    <div>
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-300 text-sm font-medium mb-4">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
        </svg>
        {t.certifications.label}
      </div>
      <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-white">{t.certifications.title}</h2>
      <p class="mt-3 text-lg text-gray-600 dark:text-gray-400">{t.certifications.subtitle}</p>
    </div>
    <a href="#contacto" class="focus-ring inline-flex items-center gap-2 text-base font-semibold text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 transition-colors">
      {t.certifications.cta}
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
      </svg>
    </a>
  </div>

  <!-- Certifications container with gradient -->
  <div class="relative">
    <!-- Gradient fade overlay -->
    <div id="certs-fade" class={`absolute bottom-0 left-0 right-0 h-40 pointer-events-none z-10 bg-gradient-to-t from-gray-50/95 dark:from-gray-900/95 via-gray-50/40 dark:via-gray-900/40 to-transparent backdrop-blur-[2px] transition-opacity duration-300 ${hasMore ? 'opacity-100' : 'opacity-0'}`}></div>

    <div id="certs-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {allCertifications.map((c, index) => (
        <article class={`cert-hidden relative group rounded-2xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 p-6 shadow-md hover:shadow-2xl dark:shadow-gray-900/30 transition-all duration-300 hover:-translate-y-1 ${index >= INITIAL_COUNT ? '' : ''}`}>
          <div class={`absolute top-0 left-0 w-full h-1 rounded-t-2xl ${c.color}`}></div>
          <h3 class="text-lg font-bold text-gray-900 dark:text-white pr-8">
            <a href={c.href} target="_blank" rel="noopener noreferrer" class="focus-ring hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
              {c.title}
            </a>
          </h3>
          <p class="mt-3 text-sm text-gray-600 dark:text-gray-400">{c.subtitle}</p>
          <p class="mt-2 text-xs text-gray-400 dark:text-gray-500">{c.date}</p>
          
          <div class="mt-5 flex items-center justify-between">
            <a href={c.href} target="_blank" rel="noopener noreferrer" class="focus-ring text-sm font-medium text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 flex items-center gap-1">
              {t.certifications.viewCertificate}
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </div>
        </article>
      ))}
    </div>

    <!-- Load More Button -->
    {hasMore && (
      <div id="load-more-certs-container" class="relative z-20 flex justify-center mt-8">
        <button
          id="load-more-certs-btn"
          class="focus-ring inline-flex items-center gap-2 px-8 py-4 rounded-xl bg-white dark:bg-gray-800 border-2 border-green-500 text-green-600 dark:text-green-400 font-bold text-lg shadow-lg hover:shadow-xl hover:bg-green-50 dark:hover:bg-gray-700 hover:border-green-600 transition-all duration-300 hover:scale-105"
        >
          <svg id="certs-btn-icon" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
          <span id="load-more-certs-text">{lang === 'es' ? 'Ver todas las certificaciones' : 'View all certifications'}</span>
        </button>
      </div>
    )}
  </div>
</section>

<style>
  /* Single row with fade on all screen sizes */
  .cert-hidden:nth-child(n+4) {
    display: none;
  }
  .cert-hidden.expanded {
    display: block;
    animation: fadeSlideIn 0.4s ease-out forwards;
  }
  #certs-fade {
    display: block;
  }
  #load-more-certs-container {
    display: flex;
  }
  
  @keyframes fadeSlideIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<script>
  const loadMoreBtn = document.getElementById('load-more-certs-btn');
  const loadMoreText = document.getElementById('load-more-certs-text');
  const loadMoreContainer = document.getElementById('load-more-certs-container');
  const certsFade = document.getElementById('certs-fade');
  const certsBtnIcon = document.getElementById('certs-btn-icon');
  const hiddenCerts = document.querySelectorAll('.cert-hidden');
  const isSpanish = window.location.pathname.startsWith('/es');

  const verMas = isSpanish ? 'Ver todas las certificaciones' : 'View all certifications';
  const verMenos = isSpanish ? 'Ver menos' : 'Show less';

  let isExpanded = false;

  loadMoreBtn?.addEventListener('click', () => {
    isExpanded = !isExpanded;
    
    if (isExpanded) {
      // Show all certs with staggered animation
      hiddenCerts.forEach((el, index) => {
        el.classList.add('expanded');
        (el as HTMLElement).style.animationDelay = `${index * 100}ms`;
      });
      
      certsFade?.classList.add('opacity-0');
      if (loadMoreText) loadMoreText.textContent = verMenos;
      if (certsBtnIcon) {
        certsBtnIcon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7"/>';
      }
    } else {
      // Collapse back
      hiddenCerts.forEach((el) => {
        el.classList.remove('expanded');
        (el as HTMLElement).style.animationDelay = '';
      });
      
      certsFade?.classList.remove('opacity-0');
      if (loadMoreText) loadMoreText.textContent = verMas;
      if (certsBtnIcon) {
        certsBtnIcon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>';
      }
    }
  });
</script>