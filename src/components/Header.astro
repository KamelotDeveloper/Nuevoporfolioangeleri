---
import ThemeToggle from './ThemeToggle.astro';
import LanguageToggle from './LanguageToggle.astro';
import { translations, type Lang } from '../i18n/translations';

interface Props {
  lang?: Lang;
}

const { lang = 'es' } = Astro.props;
const t = translations[lang];

const links = [
  { href: '#inicio', key: 'home' },
  { href: '#sobre-mi', key: 'about' },
  { href: '#proyectos', key: 'projects' },
  { href: '#certificaciones', key: 'certifications' },
  { href: '#contacto', key: 'contact' },
];
---

<header class="sticky top-0 z-50 backdrop-filter backdrop-blur bg-white/80 dark:bg-gray-900/80 border-b border-gray-200 dark:border-gray-700">
  <div class="container-max mx-auto px-4 sm:px-6 lg:px-8">
    <div class="h-16 flex items-center justify-between">
      <a href="#inicio" class="flex items-center gap-3 focus-ring" aria-label="Ir al inicio">
        <img src="/avatar.jpg" alt="Foto de perfil" class="w-9 h-9 rounded-full object-cover border border-gray-200 dark:border-gray-600" />
        <div class="leading-tight">
          <p class="text-sm font-semibold text-gray-900 dark:text-white">Giuliano Angeleri</p>
          <p class="text-xs text-gray-500 dark:text-gray-400">IA · Automatización · Desarrollo Web</p>
        </div>
      </a>

      <!-- Desktop nav -->
      <nav class="hidden md:flex items-center gap-6" aria-label="Navegación principal">
        {links.map((l) => (
          <a href={l.href} class="text-sm font-medium text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white focus-ring">
            {t.nav[l.key as keyof typeof t.nav]}
          </a>
        ))}
        <div class="flex items-center gap-3">
          <a
            href="https://www.linkedin.com/in/giulianoangeleri"
            target="_blank"
            rel="noopener noreferrer"
            class="text-sm font-medium text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 focus-ring"
          >
            {t.nav.linkedIn}
          </a>
          <a
            href="https://github.com/KamelotDeveloper"
            target="_blank"
            rel="noopener noreferrer"
            class="text-sm font-medium text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 focus-ring"
          >
            {t.nav.github}
          </a>
          <LanguageToggle />
          <ThemeToggle />
        </div>
      </nav>

      <!-- Mobile toggle + Theme + Lang -->
      <div class="flex items-center gap-2 md:hidden">
        <LanguageToggle />
        <ThemeToggle />
        <button
          id="menuToggle"
          class="inline-flex items-center justify-center w-10 h-10 rounded-lg border border-gray-200 dark:border-gray-600 focus-ring"
          aria-label={t.footer.openMenu}
          aria-expanded="false"
          aria-controls="mobileMenu"
          type="button"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-gray-700 dark:text-gray-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile menu -->
  <div id="mobileMenu" class="md:hidden hidden border-t border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900">
    <div class="container-max mx-auto px-4 sm:px-6 lg:px-8 py-4">
      <nav class="grid gap-2" aria-label="Navegación móvil">
        {links.map((l) => (
          <a href={l.href} class="py-2 text-sm font-medium text-gray-700 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white focus-ring">
            {t.nav[l.key as keyof typeof t.nav]}
          </a>
        ))}
        <div class="pt-3 mt-2 border-t border-gray-100 dark:border-gray-700 flex gap-4">
          <a
            href="https://www.linkedin.com/in/giulianoangeleri"
            target="_blank"
            rel="noopener noreferrer"
            class="text-sm font-medium text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 focus-ring"
          >
            {t.nav.linkedIn}
          </a>
          <a
            href="https://github.com/KamelotDeveloper"
            target="_blank"
            rel="noopener noreferrer"
            class="text-sm font-medium text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 focus-ring"
          >
            {t.nav.github}
          </a>
        </div>
      </nav>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('menuToggle');
  const menu = document.getElementById('mobileMenu');

  function setOpen(isOpen: boolean) {
    menu?.classList.toggle('hidden', !isOpen);
    btn?.setAttribute('aria-expanded', String(isOpen));
  }

  btn?.addEventListener('click', () => {
    const isOpen = btn.getAttribute('aria-expanded') === 'true';
    setOpen(!isOpen);
  });

  menu?.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (target && target.tagName === 'A') setOpen(false);
  });
</script>