---
import { translations, type Lang } from '../i18n/translations';

interface Props {
  lang?: Lang;
}

const { lang = 'es' } = Astro.props;
const t = translations[lang];

const allProjects = [
  { name: 'PE Business Broker', href: 'https://pebusinessbroker.com/', image: '/6a.webp', description: lang === 'es' ? 'Sitio institucional orientado a conversión y contacto.' : 'Institutional website focused on conversion and contact.', tags: ['Astro', 'Performance'] },
  { name: 'Alma Ingeniería', href: 'https://almaingenieria.com.ar/', image: '/alma.png', description: lang === 'es' ? 'Sitio institucional de ingeniería.' : 'Engineering institutional website.', tags: ['Astro', 'UX'] },
  { name: 'Cantera Nini', href: 'https://canteranini.netlify.app/', image: '/cantera.png', description: lang === 'es' ? 'Landing con foco en presencia digital.' : 'Landing focused on digital presence.', tags: ['Landing', 'UX'] },
  { name: 'Bella Guillita', href: 'https://bellaguillita.store/', image: '/bella.png', description: lang === 'es' ? 'Tienda online con foco en catálogo.' : 'Online store focused on catalog.', tags: ['E-commerce', 'WordPress'] },
];

const INITIAL_COUNT = 2;
const initialProjects = allProjects.slice(0, INITIAL_COUNT);
const hasMore = allProjects.length > INITIAL_COUNT;
---

<section id="proyectos" class="py-16 sm:py-24 bg-blue-50 dark:bg-gray-800/50">
  <div class="flex items-end justify-between gap-6 flex-wrap mb-12">
    <div>
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 text-sm font-medium mb-4">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
        {t.projects.label}
      </div>
      <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-white">{t.projects.title}</h2>
      <p class="mt-3 text-lg text-gray-600 dark:text-gray-400">{t.projects.subtitle}</p>
    </div>
    <a 
      href="https://wa.me/543571591614?text=Hola%2C%20vi%20tu%20portfolio%20y%20me%20interesa%20un%20proyecto%20similar" 
      target="_blank" 
      rel="noopener noreferrer" 
      class="focus-ring inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-green-500 hover:bg-green-600 text-white font-bold text-base transition-all hover:scale-105 hover:shadow-lg hover:shadow-green-500/25"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
      </svg>
      {t.projects.cta}
    </a>
  </div>

  <!-- Projects container with gradient -->
  <div class="relative">
    <!-- Gradient fade overlay (hidden when expanded) -->
    <div id="projects-fade" class={`absolute bottom-0 left-0 right-0 h-48 pointer-events-none z-10 bg-gradient-to-t from-blue-50 dark:from-gray-800/50 to-transparent transition-opacity duration-300 ${hasMore ? 'opacity-100' : 'opacity-0'}`}></div>

    <div id="projects-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
      {allProjects.map((p, index) => (
        <a
          href={p.href}
          target="_blank"
          rel="noopener noreferrer"
          class={`group rounded-2xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 overflow-hidden shadow-md hover:shadow-2xl dark:shadow-gray-900/50 transition-all duration-300 hover:-translate-y-2 focus-ring ${index >= INITIAL_COUNT ? 'projects-hidden' : ''}`}
          aria-label={`${lang === 'es' ? 'Ver proyecto' : 'View project'}: ${p.name}`}
        >
          <div class="relative h-48 bg-gray-100 dark:bg-gray-700 overflow-hidden">
            <img src={p.image} alt={p.name} width="400" height="300" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" loading="lazy" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end p-4">
              <span class="text-white text-sm font-medium">{t.projects.visitSite}</span>
            </div>
          </div>
          <div class="p-5">
            <h3 class="text-base font-bold text-gray-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">{p.name}</h3>
            <p class="mt-2 text-sm text-gray-600 dark:text-gray-400 line-clamp-2">{p.description}</p>
            <div class="mt-4 flex flex-wrap gap-2">
              {p.tags.map((tag) => (
                <span class="text-xs font-medium px-2.5 py-1 rounded-full bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300">{tag}</span>
              ))}
            </div>
          </div>
        </a>
      ))}

      </section>
    {hasMore && (
      <div id="load-more-container" class="relative z-20 flex justify-center mt-8">
        <button
          id="load-more-btn"
          class="focus-ring inline-flex items-center gap-2 px-8 py-4 rounded-xl bg-white dark:bg-gray-800 border-2 border-blue-500 text-blue-600 dark:text-blue-400 font-bold text-lg shadow-lg hover:shadow-xl hover:bg-blue-50 dark:hover:bg-gray-700 hover:border-blue-600 transition-all duration-300 hover:scale-105"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
          <span id="load-more-text">{lang === 'es' ? 'Ver todos los proyectos' : 'View all projects'}</span>
        </button>
      </div>
    )}
  </div>
</section>

<style>
  /* Mobile: show limited with fade */
  @media (max-width: 767px) {
    .projects-hidden {
      display: none;
    }
    .projects-hidden.expanded {
      display: block;
      animation: fadeSlideIn 0.4s ease-out forwards;
    }
    #projects-fade {
      display: block;
    }
    #load-more-container {
      display: flex;
    }
  }
  
  /* Tablet and up: show all, hide button */
  @media (min-width: 768px) {
    #projects-fade {
      display: none !important;
    }
    #load-more-container {
      display: none !important;
    }
    .projects-hidden {
      display: block !important;
    }
  }
  
  @keyframes fadeSlideIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<script>
  const loadMoreBtn = document.getElementById('load-more-btn');
  const loadMoreText = document.getElementById('load-more-text');
  const loadMoreContainer = document.getElementById('load-more-container');
  const projectsFade = document.getElementById('projects-fade');
  const hiddenProjects = document.querySelectorAll('.projects-hidden');
  const isSpanish = window.location.pathname.startsWith('/es');

  let isExpanded = false;

  loadMoreBtn?.addEventListener('click', () => {
    isExpanded = !isExpanded;
    
    if (isExpanded) {
      // Show all projects
      hiddenProjects.forEach((el, index) => {
        el.classList.add('expanded');
        (el as HTMLElement).style.animationDelay = `${index * 100}ms`;
      });
      
      // Hide fade and button
      projectsFade?.classList.add('opacity-0');
      if (loadMoreContainer) loadMoreContainer.style.display = 'none';
      
      // Change button text
      if (loadMoreText) {
        loadMoreText.textContent = isSpanish ? 'Ocultar proyectos' : 'Hide projects';
      }
    }
  });
</script>