---
import { translations, type Lang } from '../i18n/translations';

interface Props {
  lang?: Lang;
}

const { lang = 'es' } = Astro.props;
const t = translations[lang];
const baseUrl = import.meta.env.BASE_URL;

const allProjects = [
  { name: 'PE Business Broker', href: 'https://pebusinessbroker.com/', image: baseUrl + '/6a.webp', description: lang === 'es' ? 'Sitio institucional orientado a conversión y contacto.' : 'Institutional website focused on conversion and contact.', tags: ['Astro', 'Performance'] },
  { name: 'Alma Ingeniería', href: 'https://almaingenieria.com.ar/', image: baseUrl + '/alma.png', description: lang === 'es' ? 'Sitio institucional de ingeniería.' : 'Engineering institutional website.', tags: ['Astro', 'UX'] },
  { name: 'Cantera Nini', href: 'https://canteranini.netlify.app/', image: baseUrl + '/cantera.png', description: lang === 'es' ? 'Landing con foco en presencia digital.' : 'Landing focused on digital presence.', tags: ['Landing', 'UX'] },
  { name: 'Ordo Web', href: '#', image: '', description: '', tags: [], comingSoon: true },
];


---

<section id="proyectos" class="py-16 sm:py-24 bg-blue-50 dark:bg-gray-800/50">
  <div class="flex items-end justify-between gap-6 flex-wrap mb-12">
    <div>
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 text-sm font-medium mb-4">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
        {t.projects.label}
      </div>
      <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-white">{t.projects.title}</h2>
      <p class="mt-3 text-lg text-gray-600 dark:text-gray-400">{t.projects.subtitle}</p>
    </div>
    <a 
      href="https://wa.me/543571591614?text=Hola%2C%20vi%20tu%20portfolio%20y%20me%20interesa%20un%20proyecto%20similar" 
      target="_blank" 
      rel="noopener noreferrer" 
      class="focus-ring inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-green-500 hover:bg-green-600 text-white font-bold text-base transition-all hover:scale-105 hover:shadow-lg hover:shadow-green-500/25"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
      </svg>
      {t.projects.cta}
    </a>
  </div>

  <!-- Projects carousel -->
  <div class="relative">
    <!-- Navigation arrows -->
    <button id="projects-prev" class="focus-ring absolute left-0 top-1/2 -translate-y-1/2 -translate-x-4 z-20 w-10 h-10 rounded-full bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 shadow-lg flex items-center justify-center hover:bg-gray-50 dark:hover:bg-gray-700 transition-all hidden md:flex" aria-label="Anterior">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-gray-600 dark:text-gray-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
      </svg>
    </button>
    <button id="projects-next" class="focus-ring absolute right-0 top-1/2 -translate-y-1/2 translate-x-4 z-20 w-10 h-10 rounded-full bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 shadow-lg flex items-center justify-center hover:bg-gray-50 dark:hover:bg-gray-700 transition-all hidden md:flex" aria-label="Siguiente">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-gray-600 dark:text-gray-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
    </button>

    <!-- Carousel track -->
    <div id="projects-track" class="flex gap-6 overflow-x-auto scroll-smooth snap-x snap-mandatory pb-4 -mb-4 scrollbar-hide">
      {allProjects.map((p, index) => {
        const cardClasses = "group rounded-2xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 overflow-hidden shadow-md hover:shadow-2xl dark:shadow-gray-900/50 transition-all duration-300 hover:-translate-y-2 snap-start shrink-0 w-full sm:w-[calc(50%-12px)] lg:w-[calc(33.333%-16px)] xl:w-[calc(25%-18px)]";

        if (p.comingSoon) {
          return (
            <div class={cardClasses}>
              <div class="relative h-48 bg-gradient-to-br from-blue-600 to-indigo-700 overflow-hidden flex flex-col items-center justify-center">
                <div class="relative mb-2">
                  <div class="w-10 h-10 border-[3px] border-white/20 border-t-white rounded-full animate-spin"></div>
                </div>
                <span class="text-white text-lg font-bold tracking-tight">Ordo Web</span>
                <span class="text-blue-200 text-sm font-medium mt-0.5">
                  {lang === 'es' ? 'Próximamente' : 'Coming soon'}
                </span>
                <div class="flex gap-1.5 mt-3">
                  <div class="w-2 h-2 bg-white/60 rounded-full animate-bounce" style="animation-delay: 0s; animation-duration: 1s"></div>
                  <div class="w-2 h-2 bg-white/60 rounded-full animate-bounce" style="animation-delay: 0.15s; animation-duration: 1s"></div>
                  <div class="w-2 h-2 bg-white/60 rounded-full animate-bounce" style="animation-delay: 0.3s; animation-duration: 1s"></div>
                </div>
              </div>
              <div class="p-5">
                <h3 class="text-base font-bold text-gray-900 dark:text-white">Ordo Web</h3>
                <p class="mt-2 text-sm text-gray-600 dark:text-gray-400 line-clamp-2">
                  {lang === 'es' ? 'Proyecto en desarrollo...' : 'Project in development...'}
                </p>
                <div class="mt-4 flex flex-wrap gap-2">
                  <span class="text-xs font-medium px-2.5 py-1 rounded-full bg-blue-100 dark:bg-blue-900/30 text-blue-600 dark:text-blue-300">
                    {lang === 'es' ? 'Próximamente' : 'Coming Soon'}
                  </span>
                </div>
              </div>
            </div>
          );
        }

        return (
          <a
            href={p.href}
            target="_blank"
            rel="noopener noreferrer"
            class={cardClasses + " focus-ring"}
            aria-label={`${lang === 'es' ? 'Ver proyecto' : 'View project'}: ${p.name}`}
          >
            <div class="relative h-48 bg-gray-100 dark:bg-gray-700 overflow-hidden">
              <img src={p.image} alt={p.name} width="400" height="300" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" loading={index === 0 ? undefined : "lazy"} />
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end p-4">
                <span class="text-white text-sm font-medium">{t.projects.visitSite}</span>
              </div>
            </div>
            <div class="p-5">
              <h3 class="text-base font-bold text-gray-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">{p.name}</h3>
              <p class="mt-2 text-sm text-gray-600 dark:text-gray-400 line-clamp-2">{p.description}</p>
              <div class="mt-4 flex flex-wrap gap-2">
                {p.tags.map((tag) => (
                  <span class="text-xs font-medium px-2.5 py-1 rounded-full bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300">{tag}</span>
                ))}
              </div>
            </div>
          </a>
        );
      })}
    </div>

    <!-- Dots indicator -->
    <div id="projects-dots" class="flex justify-center gap-2 mt-6">
    </div>
  </div>
</section>

<style>
  /* Hide scrollbar */
  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>

<script>
  const track = document.getElementById('projects-track');
  const prevBtn = document.getElementById('projects-prev');
  const nextBtn = document.getElementById('projects-next');
  const dotsContainer = document.getElementById('projects-dots');
  const isSpanish = window.location.pathname.startsWith('/es');
  
  if (track) {
    const cards = Array.from(track.children) as HTMLElement[];
    const totalSlides = cards.length;
    let currentIndex = 0;
    let autoPlay: ReturnType<typeof setInterval> | null = null;
    const AUTOPLAY_DELAY = 5000;

    // Create dots
    if (dotsContainer) {
      for (let i = 0; i < totalSlides; i++) {
        const dot = document.createElement('button');
        dot.className = `w-2.5 h-2.5 rounded-full transition-all duration-300 focus-ring ${i === 0 ? 'bg-blue-600 w-6' : 'bg-gray-300 dark:bg-gray-600 hover:bg-gray-400 dark:hover:bg-gray-500'}`;
        dot.setAttribute('aria-label', `${isSpanish ? 'Ir al proyecto' : 'Go to project'} ${i + 1}`);
        dot.addEventListener('click', () => goTo(i));
        dotsContainer.appendChild(dot);
      }
    }

    function updateDots() {
      if (!dotsContainer) return;
      const dots = dotsContainer.children;
      for (let i = 0; i < dots.length; i++) {
        const dot = dots[i] as HTMLElement;
        if (i === currentIndex) {
          dot.className = 'w-2.5 h-2.5 rounded-full transition-all duration-300 bg-blue-600 w-6';
        } else {
          dot.className = 'w-2.5 h-2.5 rounded-full transition-all duration-300 bg-gray-300 dark:bg-gray-600 hover:bg-gray-400 dark:hover:bg-gray-500';
        }
      }
    }

    function getCardWidth(): number {
      if (cards.length === 0) return 0;
      const card = cards[0];
      const style = getComputedStyle(card);
      const gap = 24; // gap-6 = 24px
      // On xl screens: 4 per row → card width = (container - 3*gap) / 4
      // On lg: 3 per row
      // On sm: 2 per row
      // Default: 1 per row
      return card.offsetWidth + gap;
    }

    function goTo(index: number) {
      if (index < 0) index = 0;
      if (index >= totalSlides) index = totalSlides - 1;
      currentIndex = index;
      const step = getCardWidth();
      track.scrollTo({ left: step * index, behavior: 'smooth' });
      updateDots();
      updateArrows();
    }

    function updateArrows() {
      if (!prevBtn || !nextBtn) return;
      prevBtn.style.opacity = currentIndex === 0 ? '0.3' : '1';
      prevBtn.style.pointerEvents = currentIndex === 0 ? 'none' : 'auto';
      nextBtn.style.opacity = currentIndex >= totalSlides - 1 ? '0.3' : '1';
      nextBtn.style.pointerEvents = currentIndex >= totalSlides - 1 ? 'none' : 'auto';
    }

    function getCurrentIndex(): number {
      if (!track) return 0;
      const step = getCardWidth();
      if (step === 0) return 0;
      return Math.round(track.scrollLeft / step);
    }

    // Navigation
    nextBtn?.addEventListener('click', () => goTo(currentIndex + 1));
    prevBtn?.addEventListener('click', () => goTo(currentIndex - 1));

    // Track scroll for syncing
    track.addEventListener('scroll', () => {
      currentIndex = getCurrentIndex();
      updateDots();
      updateArrows();
    });

    // Auto-play
    function startAutoPlay() {
      stopAutoPlay();
      autoPlay = setInterval(() => {
        if (currentIndex >= totalSlides - 1) {
          goTo(0);
        } else {
          goTo(currentIndex + 1);
        }
      }, AUTOPLAY_DELAY);
    }

    function stopAutoPlay() {
      if (autoPlay) {
        clearInterval(autoPlay);
        autoPlay = null;
      }
    }

    // Pause on hover
    track.addEventListener('mouseenter', stopAutoPlay);
    track.addEventListener('mouseleave', startAutoPlay);
    // Touch pause
    track.addEventListener('touchstart', stopAutoPlay);
    track.addEventListener('touchend', startAutoPlay);

    // Initialize arrows visibility
    updateArrows();

    // Start autoplay if more than 1 card fits
    // (check after a tick for layout)
    requestAnimationFrame(() => startAutoPlay());
  }
</script>