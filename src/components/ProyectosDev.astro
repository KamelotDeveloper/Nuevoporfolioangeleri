---
import { translations, type Lang } from '../i18n/translations';

interface Props {
  lang?: Lang;
}

const { lang = 'es' } = Astro.props;
const t = translations[lang];

const projects = [
  {
    key: 'ordo',
    title: t.devProjects.ordo.title,
    badge: t.devProjects.ordo.badge,
    description: t.devProjects.ordo.description,
    features: t.devProjects.ordo.features,
    cta: t.devProjects.ordo.cta,
    comingSoon: null,
    href: 'https://kamelotdeveloper.github.io/Ordo-landing/',
    borderColor: 'border-blue-500/30',
    badgeBg: 'bg-blue-100 dark:bg-blue-900/30',
    badgeText: 'text-blue-700 dark:text-blue-300',
  },
  {
    key: 'gym',
    title: t.devProjects.gym.title,
    badge: t.devProjects.gym.badge,
    description: t.devProjects.gym.description,
    features: t.devProjects.gym.features,
    cta: t.devProjects.gym.cta,
    comingSoon: null,
    href: '#contacto',
    borderColor: 'border-emerald-500/30',
    badgeBg: 'bg-emerald-100 dark:bg-emerald-900/30',
    badgeText: 'text-emerald-700 dark:text-emerald-300',
  },
];
---

<section class="py-16 sm:py-24 border-t border-gray-200 dark:border-gray-700">
  <div class="flex items-end justify-between gap-6 flex-wrap mb-12">
    <div>
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-100 dark:bg-indigo-900/30 text-indigo-700 dark:text-indigo-300 text-sm font-medium mb-4">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
        </svg>
        {t.devProjects.label}
      </div>
      <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-white">{t.devProjects.title}</h2>
      <p class="mt-3 text-lg text-gray-600 dark:text-gray-400">{t.devProjects.subtitle}</p>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
    {projects.map((p) => (
      <div class={`rounded-2xl border ${p.borderColor} bg-white dark:bg-gray-800 p-6 sm:p-8 shadow-lg dark:shadow-gray-900/30 hover:shadow-xl transition-shadow`}>
        <div class="flex items-start justify-between gap-4">
          <div>
            <span class={`inline-block px-3 py-1 rounded-full text-xs font-semibold ${p.badgeBg} ${p.badgeText} mb-3`}>
              {p.badge}
            </span>
            <h3 class="text-2xl font-bold text-gray-900 dark:text-white">{p.title}</h3>
          </div>
          <!-- Code icon -->
          <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-gray-300 dark:text-gray-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
          </svg>
        </div>

        <p class="mt-4 text-gray-600 dark:text-gray-300 leading-relaxed">{p.description}</p>

        <ul class="mt-6 space-y-3">
          {p.features.map((f: string) => (
            <li class="flex items-start gap-3 text-sm text-gray-600 dark:text-gray-400">
              <svg class="w-5 h-5 text-blue-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              {f}
            </li>
          ))}
        </ul>

        <div class="mt-8 pt-6 border-t border-gray-100 dark:border-gray-700">
          {p.href ? (
            <a
              href={p.href}
              class="focus-ring inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-semibold text-sm transition-all hover:scale-105 hover:shadow-lg hover:shadow-blue-600/25"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              {p.cta}
            </a>
          ) : (
            <span class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-gray-100 dark:bg-gray-700 text-gray-400 dark:text-gray-500 font-semibold text-sm cursor-not-allowed">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              {p.comingSoon}
            </span>
          )}
        </div>
      </div>
    ))}
  </div>
</section>
